{
  "name": "vibepaws",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Vibepaws \u2014 AI coding pet for your coding agents (MVP)",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "electron desktop/main.js",
    "core": "node --experimental-strip-types src/core/server.ts",
    "core:watch": "node --watch --experimental-strip-types src/core/server.ts",
    "sim": "node --experimental-strip-types src/simulator/index.ts",
    "db:init": "node --experimental-strip-types src/db/migrate.ts",
    "adapter:install": "node --experimental-strip-types src/adapters/install.ts",
    "adapter:uninstall": "node --experimental-strip-types src/adapters/uninstall.ts",
    "hook": "node --experimental-strip-types src/adapters/hook_agent.ts",
    "bridge": "node --experimental-strip-types src/adapters/bridge.ts",
    "ui": "node --experimental-strip-types src/ui/server.ts",
    "assets": "python3 scripts/build_assets.py",
    "states": "python3 scripts/gen_states.py",
    "desktop": "electron desktop/main.js",
    "dist:mac": "npm run build:dsh && electron-builder --mac --arm64",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts ui/**/*.test.js desktop/*.test.js scripts/*.test.ts",
    "verify:release": "node --experimental-strip-types scripts/verify_release.ts",
    "cask:update": "node --experimental-strip-types scripts/update_cask.ts",
    "build:dsh": "node --experimental-strip-types scripts/build_dsh_plugin.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.vibepaws.desktop",
    "productName": "Vibepaws",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "package.json",
      "!desktop/*.test.js",
      "!node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "src",
        "to": "src",
        "filter": [
          "**/*",
          "!**/*.test.ts",
          "!adapters/dsh_compile.ts"
        ]
      },
      {
        "from": "ui",
        "to": "ui"
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3",
        "filter": [
          "**/*",
          "!prebuilds/**"
        ]
      },
      {
        "from": "node_modules/better-sqlite3/prebuilds/darwin-${arch}.node",
        "to": "node_modules/better-sqlite3/prebuilds/darwin-${arch}.node"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "npmRebuild": false,
    "afterAllArtifactBuild": "./build/notarize-dmg.cjs",
    "afterPack": "./build/adhoc-sign.cjs"
  }
}
